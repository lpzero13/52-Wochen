# Pfad zur Norgate-SQLite-Datei. Diese Datei wird nur lesend geöffnet.
NORGATE_DB_PATH=C:\path\to\norgate.sqlite

# Eigener Anwendungszustand dieses Projekts
SCANNER_DB_PATH=var\52w_scanner.sqlite
PORT=8020

# Kostenloser aktueller Scanner-Cache; Norgate bleibt die historische Quelle.
LIVE_DATA_DIR=var\live
# Beim App-Start und danach stündlich prüfen, ob eine neue abgeschlossene US-Session vorliegt.
LIVE_AUTO_UPDATE=true
